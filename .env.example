# Dispatch — Fase 1
# Salin file ini menjadi .env (jangan commit .env).

# Port HTTP backend
PORT=8080

# Koneksi PostgreSQL + PostGIS lokal.
# Ganti CHANGE_ME dengan password user PostgreSQL di mesinmu.
DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/dispatch?sslmode=disable

# Rahasia penandatangan JWT. Wajib diganti dengan string acak yang panjang.
# Contoh membuat: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET
JWT_TTL=24h

# Origin frontend yang diizinkan (pisahkan dengan koma bila lebih dari satu).
CORS_ORIGIN=http://localhost:5173

# Fase 2 — pencarian kandidat kendaraan terdekat.
# OSRM publik dipakai lewat /table; request dibatasi timeout 5 detik di kode.
OSRM_BASE_URL=https://router.project-osrm.org

# Radius awal kandidat dari titik insiden, dalam meter (default 50 km).
DISPATCH_RADIUS_M=50000

# Fase 3/4 - pengali kecepatan simulasi kendaraan (default 20x).
SIM_SPEED_MULTIPLIER=20
